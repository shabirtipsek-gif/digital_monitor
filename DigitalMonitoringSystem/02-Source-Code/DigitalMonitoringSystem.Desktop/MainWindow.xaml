<Window x:Class="DigitalMonitoringSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="A DIGITAL MONITORING SYSTEM FOR COMPUTERS AND OTHER INFORMATION TECHNOLOGY DEVICES AT MUKONO DISTRICT LOCAL GOVERNMENT" Height="760" Width="1280" WindowStartupLocation="CenterScreen">
    <Grid Background="#0b1220">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#111827" BorderBrush="#1f2937" BorderThickness="0,0,0,1" Padding="24">
            <DockPanel>
                <TextBlock Text="A DIGITAL MONITORING SYSTEM FOR COMPUTERS AND OTHER INFORMATION TECHNOLOGY DEVICES AT MUKONO DISTRICT LOCAL GOVERNMENT" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="900" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#0f172a" BorderBrush="#2dd4bf" BorderThickness="1" CornerRadius="12" Padding="10,6">
                        <TextBlock Text="System Status" Foreground="#a7f3d0" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Margin="14,0,0,0" Text="{Binding HealthStatus}" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <WrapPanel>
                    <Border Width="180" Height="110" Background="#111827" CornerRadius="14" Margin="0,0,16,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Total Devices" Foreground="#9ca3af"/>
                            <TextBlock Text="{Binding TotalDevices}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Width="180" Height="110" Background="#0f172a" CornerRadius="14" Margin="0,0,16,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Online" Foreground="#9ca3af"/>
                            <TextBlock Text="{Binding OnlineDevices}" Foreground="#4ade80" FontSize="28" FontWeight="Bold" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Width="180" Height="110" Background="#0f172a" CornerRadius="14" Margin="0,0,16,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Open Alerts" Foreground="#9ca3af"/>
                            <TextBlock Text="{Binding OpenAlerts}" Foreground="#fbbf24" FontSize="28" FontWeight="Bold" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Width="180" Height="110" Background="#111827" CornerRadius="14" Margin="0,0,16,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Critical Alerts" Foreground="#9ca3af"/>
                            <TextBlock Text="{Binding CriticalAlerts}" Foreground="#f87171" FontSize="28" FontWeight="Bold" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Background="#111827" CornerRadius="14" Padding="18" Margin="0,10,0,20">
                    <StackPanel>
                        <TextBlock Text="Managed devices" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" Margin="0,12,0,0" Background="#0b1220" HeadersVisibility="Column" CanUserAddRows="False" RowHeaderWidth="0" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="80"/>
                                <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Background="#111827" CornerRadius="14" Padding="18" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Active incidents" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding Alerts}" Background="Transparent" BorderThickness="0" Margin="0,12,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1f2937" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Severity}" Foreground="#fbbf24" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Title}" Foreground="White" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Source}" Foreground="#9ca3af" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Background="#111827" CornerRadius="14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Policies" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding Policies}" Background="Transparent" BorderThickness="0" Margin="0,12,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111827" BorderBrush="#1f2937" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Category}" Foreground="#9ca3af" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#60a5fa" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
